<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sideloaded personal launcher: see every launchable app and widget provider. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Recently used apps on the taskbar (granted in Settings > Usage access, or via adb appops). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Battery tap / swipe down on the desktop pulls down the system notification panel. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Screen timeout in Customize and the Keep awake tile ("Modify system settings", granted by the user). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Running apps on the taskbar: TabDesk talks to the tablet's own wireless debugging (on 127.0.0.1).
         Also checking GitHub for a newer TabDesk and downloading it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing TabDesk's own updates (Customize → About), the second without asking each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The helper's setup checks that Wi-Fi is connected (wireless debugging needs it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pairing with wireless debugging: the code is typed into TabDesk's notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets TabDesk switch wireless debugging on at startup. Only adb can grant it, which TabDesk does once paired. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TabDesk">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
            <!-- Long-press the Keep awake tile: open Customize. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The app icon: asks to become the home app (home apps have no icon otherwise); after that, opens Customize. -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.tabdesk.welcome"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accepts "Add to Home screen" shortcut requests (e.g. from Chrome). -->
        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <service
            android:name=".DotsService"
            android:exported="true"
            android:label="@string/dots_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick settings tile: keep the screen on / back to the normal timeout. -->
        <service
            android:name=".AwakeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_awake"
            android:label="@string/awake_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The pairing code typed into TabDesk's pairing notification. -->
        <receiver
            android:name=".helper.PairCodeReceiver"
            android:exported="false" />
        <!-- Android's answer when TabDesk installs its own update. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
        <!-- After TabDesk's own update: back to the front if Android showed another home screen meanwhile. -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Optional: double-tap the desktop to lock. Enabled by the user in Accessibility settings. -->
        <service
            android:name=".LockService"
            android:exported="false"
            android:label="@string/lock_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
