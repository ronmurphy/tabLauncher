<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="dev.tabdesk" />
        <package android:name="dev.tabdesk.seethrough" />
    </queries>
    <application android:label="@string/app_name">
        <!-- Driven over adb with am start and a "cmd" extra (see run.sh). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The same commands as broadcasts, which leave whatever app is in front where it is (to read it). -->
        <receiver android:name=".CommandReceiver" android:exported="true" />
    </application>
</manifest>
